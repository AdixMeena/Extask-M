# Copy this file to ".env" and fill in your own values. Never commit .env.

# Supabase dashboard > Connect (or Project Settings)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with sb_publishable_). The legacy "anon" key also works.
SUPABASE_ANON_KEY=your-publishable-key

# SECRET key (starts with sb_secret_). The legacy "service_role" key also works.
# This key can read and change everything. It stays on the server only.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Port for the local server
PORT=5050

# Address of the React app, allowed by CORS. Separate several with commas.
CLIENT_URL=http://localhost:5173
